#!/bin/sh

# Redirigir output a stderr para que Git lo muestre
exec 1>&2

echo "🔍 GoReview: Analizando cambios staged..."

# 1. Encontrar la raiz del repo
ROOT_DIR=$(git rev-parse --show-toplevel)
mkdir -p "$ROOT_DIR/.goreview"

# 2. Calcular hash de cambios staged para ver si necesitamos repetir el review
# Esto incluye nombres de archivos y su contenido staged
STAGED_HASH=$(git diff --cached | sha256sum | awk '{print $1}')
LAST_HASH=$(cat "$ROOT_DIR/.goreview/last_reviewed_hash" 2>/dev/null || echo "")

if [ "$STAGED_HASH" = "$LAST_HASH" ]; then
    echo "⏩ GoReview: Los cambios no han variado desde el ultimo review. Saltando..."
    exit 0
fi

# 3. Compilar Goreview (para asegurar que usamos la version actual)
echo "🔨 Compilando Goreview..."
cd "$ROOT_DIR/goreview"
if ! go build -o build/goreview ./cmd/goreview; then
    echo "❌ Error de compilacion en GoReview. Commit bloqueado."
    exit 1
fi
cd "$ROOT_DIR"

# 4. Ejecutar Review
REVIEW_OUTPUT=$("$ROOT_DIR/goreview/build/goreview" review --staged --format markdown 2>&1)
EXIT_CODE=$?

echo "$REVIEW_OUTPUT"

# Crear directorio de logs si no existe
mkdir -p "$ROOT_DIR/logs"

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ GoReview encontro problemas."
    
    # Guardar el reporte para analisis
    echo "$REVIEW_OUTPUT" > "$ROOT_DIR/logs/last_failed_review.md"
    echo "📄 Reporte detallado guardado en logs/last_failed_review.md"

    echo "💡 Corrige los errores arriba o usa 'git commit --no-verify' para forzar (no recomendado)."
    exit 1
else
    # Guardar el reporte de exito
    echo "$REVIEW_OUTPUT" > "$ROOT_DIR/logs/last_successful_review.md"
    echo "✅ GoReview paso exitosamente."
    echo "📄 Reporte detallado guardado en logs/last_successful_review.md"
fi

# Guardar el hash del review exitoso
echo "$STAGED_HASH" > "$ROOT_DIR/.goreview/last_reviewed_hash"

echo "✅ GoReview paso exitosamente."

# Generar documentacion automatica
echo "📝 Generando borrador de changelog..."
mkdir -p .goreview
if "$ROOT_DIR/goreview/build/goreview" doc --staged > .goreview/COMMIT_DRAFT.md; then
    echo "📄 Documentacion generada en .goreview/COMMIT_DRAFT.md"
    cat .goreview/COMMIT_DRAFT.md
else
    echo "⚠️  Fallo al generar documentacion (pero el commit sigue adelante)."
fi

exit 0
