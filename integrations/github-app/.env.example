# GitHub App Configuration
GITHUB_APP_ID=your_app_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_PRIVATE_KEY_PATH=/app/config/private-key.pem

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Ollama
OLLAMA_HOST=http://localhost:11434
